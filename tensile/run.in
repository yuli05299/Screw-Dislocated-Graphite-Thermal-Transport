# thermal conductivity of Screw Carbon
potential     nep-GAP-carbon.txt
velocity      300            
time_step     1.0           

# minimize
minimize      sd 1.0e-6 10000
                   
# npt balance     
ensemble      npt_scr 300 300 100 0 0 0 100 100 100 1000
fix           0
dump_thermo   1000                 
dump_exyz     10000 0 0
run           500000             


# deform     
ensemble      npt_scr 300 300 100 0 0 0 100 100 100 1000
fix           0  
deform        4.94375e-5 0 0 1 
dump_thermo   1000           
dump_exyz     10000 1 1     
run           4000000

