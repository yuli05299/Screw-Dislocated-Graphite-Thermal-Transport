# thermal conductivity of Screw Carbon
potential     nep-GAP-carbon.txt
velocity      300            
time_step     0.5              

# npt balance   
ensemble      npt_ber 10 10 100 0 0 0 100 100 100 1000
fix           0
dump_thermo   1000                 
dump_exyz     50000 0 0
run           50000 

# npt balance  
ensemble      npt_ber 300 300 100 0 0 0 100 100 100 1000
fix           0
dump_thermo   1000                 
dump_exyz     50000 0 0
run           500000             

# heat flux distribution
ensemble      heat_nhc 300 100 20 1 14
fix           0  
compute       0 10 100 temperature
dump_thermo   1000           
dump_exyz     100000 1 1     
run           12000000
